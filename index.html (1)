<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>360° Site-Survey Viewer</title>
    
    <!-- Pannellum CSS -->
    <link rel="stylesheet" href="https://cdn.pannellum.org/2.5/pannellum.css"/>
    <!-- Pannellum JS -->
    <script type="text/javascript" src="https://cdn.pannellum.org/2.5/pannellum.js"></script>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #121212;
            color: #fff;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }
        header {
            padding: 10px 20px;
            background: #1f1f1f;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        input[type="file"] {
            background: #333;
            color: #fff;
            padding: 5px;
            border: 1px solid #555;
            cursor: pointer;
        }
        #panorama {
            width: 100%;
            flex-grow: 1;
        }
    </style>
</head>
<body>

    <header>
        <h3>Telecom 360° Viewer</h3>
        <input type="file" id="uploadImage" accept="image/*">
    </header>

    <div id="panorama"></div>

    <script>
        // Start met een standaardvoorbeeld of leeg
        let viewer = pannellum.viewer('panorama', {
            "type": "equirectangular",
            "panorama": "https://pannellum.org/images/alma.jpg", // Vervang dit door een eigen 360 foto op je repo
            "autoLoad": true,
            "showControls": true
        });

        // Zorg ervoor dat je lokaal een 360 foto kunt kiezen via je knop
        document.getElementById('uploadImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    // Vernietig oude viewer en maak een nieuwe met de ingeladen foto
                    viewer.destroy();
                    viewer = pannellum.viewer('panorama', {
                        "type": "equirectangular",
                        "panorama": event.target.result,
                        "autoLoad": true,
                        "showControls": true
                    });
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

</body>
</html>
